    {
      "name": "dolphinscheduler_workflow_create_multi_preview",
      "description": "预览 2 到 20 个混合 DolphinScheduler 任务插件节点、参数、依赖和画布布局；校验项目、数据源及 DAG；返回确认码，不创建工作流。",
      "input_schema": {
        "type": "object",
        "properties": {
          "project_code": {
            "type": "integer"
          },
          "workflow_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "node_id": {
                  "type": "string",
                  "description": "画布内唯一节点标识。"
                },
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "task_type": {
                  "type": "string",
                  "description": "DolphinScheduler 已安装的任务插件类型，使用其大写类型名，例如 SQL、SHELL、PYTHON、DATAX、HTTP。"
                },
                "task_params": {
                  "type": "object",
                  "description": "该 task_type 对应的完整任务参数 JSON 对象；字段由 DolphinScheduler 任务插件定义。敏感值使用 DOLPHINSCHEDULER_TASK_SECRET_<ALIAS> 环境引用。",
                  "additionalProperties": true
                },
                "depends_on": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "依赖的 node_id 列表。省略时串接到前一个节点；显式 [] 表示根节点。"
                },
                "worker_group": {
                  "type": "string"
                },
                "environment_code": {
                  "type": "integer"
                },
                "task_execute_type": {
                  "type": "string",
                  "enum": [
                    "BATCH",
                    "STREAM"
                  ]
                },
                "task_priority": {
                  "type": "string",
                  "enum": [
                    "HIGHEST",
                    "HIGH",
                    "MEDIUM",
                    "LOW",
                    "LOWEST"
                  ]
                },
                "fail_retry_times": {
                  "type": "integer"
                },
                "fail_retry_interval": {
                  "type": "integer"
                },
                "timeout_flag": {
                  "type": "string",
                  "enum": [
                    "OPEN",
                    "CLOSE"
                  ]
                },
                "timeout": {
                  "type": "integer"
                },
                "delay_time": {
                  "type": "integer"
                },
                "resource_ids": {
                  "type": "string"
                }
              },
              "required": [
                "node_id",
                "name",
                "task_type",
                "task_params"
              ]
            },
            "minItems": 2,
            "maxItems": 20
          }
        },
        "required": [
          "project_code",
          "workflow_name",
          "nodes"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
