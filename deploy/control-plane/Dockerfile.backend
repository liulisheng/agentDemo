FROM python:3.13-slim@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/backend/src

WORKDIR /app
COPY backend /app/backend
COPY docs/migrations /app/docs/migrations

RUN python -m pip install --no-cache-dir '/app/backend[mysql]' \
    && useradd --system --uid 10001 --create-home agent-platform \
    && mkdir -p /var/lib/agent-platform \
    && chown -R 10001:10001 /var/lib/agent-platform

USER 10001:10001
EXPOSE 8000
CMD ["uvicorn", "agent_platform.main:app", "--host", "0.0.0.0", "--port", "8000"]
